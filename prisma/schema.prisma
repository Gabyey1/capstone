generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
}

model due {
  id          Int        @id @default(autoincrement())
  homeownerId Int
  year        Int
  month       Int
  amount      Decimal    @db.Decimal(10, 2)
  amountPaid  Decimal    @default(0.00) @db.Decimal(10, 2)
  balance     Decimal    @db.Decimal(10, 2)
  status      due_status @default(UNPAID)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  homeowner   homeowner  @relation(fields: [homeownerId], references: [id], onDelete: Cascade, map: "Due_homeownerId_fkey")
  payment     payment[]

  @@unique([homeownerId, year, month], map: "Due_homeownerId_year_month_key")
  @@index([status], map: "Due_status_idx")
  @@index([year, month], map: "Due_year_month_idx")
}

model facility {
  id          Int             @id @default(autoincrement())
  name        String          @unique(map: "Facility_name_key")
  description String?
  status      facility_status @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime
  reservation reservation[]
}

model feesetting {
  id          Int             @id @default(autoincrement())
  type        feesetting_type @unique(map: "FeeSetting_type_key")
  amount      Decimal         @db.Decimal(10, 2)
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime
}

model homeowner {
  id            Int           @id @default(autoincrement())
  userId        Int           @unique(map: "Homeowner_userId_key")
  firstName     String
  middleName    String?
  lastName      String
  address       String
  contactNumber String?
  email         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  due           due[]
  user          user          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Homeowner_userId_fkey")
  payment       payment[]
  reservation   reservation[]

  @@index([lastName, firstName], map: "Homeowner_lastName_firstName_idx")
}

model payment {
  id                 Int            @id @default(autoincrement())
  homeownerId        Int
  dueId              Int?
  amount             Decimal        @db.Decimal(10, 2)
  method             payment_method
  status             payment_status @default(PENDING)
  referenceNumber    String?        @unique(map: "Payment_referenceNumber_key")
  orNumber           String?        @unique(map: "Payment_orNumber_key")
  paymongoPaymentId  String?        @unique(map: "Payment_paymongoPaymentId_key")
  paymongoCheckoutId String?        @unique(map: "Payment_paymongoCheckoutId_key")
  paidAt             DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  due                due?           @relation(fields: [dueId], references: [id], map: "Payment_dueId_fkey")
  homeowner          homeowner      @relation(fields: [homeownerId], references: [id], onDelete: Cascade, map: "Payment_homeownerId_fkey")
  receipt            receipt?

  @@index([dueId], map: "Payment_dueId_idx")
  @@index([homeownerId], map: "Payment_homeownerId_idx")
  @@index([paidAt], map: "Payment_paidAt_idx")
  @@index([status], map: "Payment_status_idx")
}

model receipt {
  id            Int      @id @default(autoincrement())
  paymentId     Int      @unique(map: "Receipt_paymentId_key")
  receiptNumber String   @unique(map: "Receipt_receiptNumber_key")
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  payment       payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "Receipt_paymentId_fkey")
}

model reservation {
  id              Int                @id @default(autoincrement())
  homeownerId     Int
  facilityId      Int
  reservationDate DateTime
  startTime       DateTime
  endTime         DateTime
  amount          Decimal            @db.Decimal(10, 2)
  status          reservation_status @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime
  facility        facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade, map: "Reservation_facilityId_fkey")
  homeowner       homeowner          @relation(fields: [homeownerId], references: [id], onDelete: Cascade, map: "Reservation_homeownerId_fkey")

  @@index([facilityId], map: "Reservation_facilityId_idx")
  @@index([homeownerId], map: "Reservation_homeownerId_idx")
  @@index([reservationDate], map: "Reservation_reservationDate_idx")
  @@index([status], map: "Reservation_status_idx")
}

model user {
  id           Int         @id @default(autoincrement())
  email        String      @unique(map: "User_email_key")
  passwordHash String
  role         user_role
  status       user_status @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  homeowner    homeowner?

  @@index([role], map: "User_role_idx")
  @@index([status], map: "User_status_idx")
}

enum feesetting_type {
  MONTHLY_DUES
  BASKETBALL_COURT
  TENNIS_COURT
  CLUBHOUSE
}

enum facility_status {
  ACTIVE
  INACTIVE
}

enum user_role {
  ADMIN
  HOMEOWNER
}

enum payment_method {
  GCASH
  MAYA
}

enum user_status {
  ACTIVE
  INACTIVE
}

enum payment_status {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum due_status {
  UNPAID
  PAID
  OVERDUE
  PARTIAL
}

enum reservation_status {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
